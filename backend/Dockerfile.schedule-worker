FROM node:lts-alpine3.23
WORKDIR /app

# Independent dependency lock: no HTTP server, mail, PDF or IoT packages.
COPY modules/schedule/worker-runtime/package.json modules/schedule/worker-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY uploads ./uploads
# Share domain source without including the rest of the backend application.
COPY modules/schedule/worker.js ./modules/schedule/worker.js
COPY modules/schedule/application/access.js modules/schedule/application/executor.js modules/schedule/application/notifications.js ./modules/schedule/application/
COPY modules/schedule/domain/rules.js ./modules/schedule/domain/rules.js
COPY modules/schedule/infrastructure/models.js ./modules/schedule/infrastructure/models.js
COPY modules/maintenance/service.js modules/maintenance/evidence-cleanup.js ./modules/maintenance/
COPY service/authorization.js service/permissionCatalog.js service/residentPropertyAccess.js ./service/
COPY service/saasMembershipService.js service/platformAuthorization.js service/platformPermissions.js ./service/
COPY models/saasMembership.js models/platformUser.js models/platformPolicy.js ./models/
COPY models/accessGrant.js models/admin.js models/condominio.js models/docs.js models/family.js models/historico_owner.js models/organization.js models/owners.js models/staff.js models/staff_admin.js ./models/
COPY scripts/migrateSchedule.js ./scripts/
COPY models/accessPolicy.js ./models/

USER node
CMD ["node", "modules/schedule/worker.js"]
